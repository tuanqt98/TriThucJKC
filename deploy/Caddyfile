{
    admin off
    auto_https disable_redirects
}
https://{$APP_HOST:trithuc.jkc.internal} {
    tls internal
    encode zstd gzip
    request_body {
        max_size 11MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=86400"
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000
    }
}
http://{$APP_HOST:trithuc.jkc.internal} {
    redir https://{$APP_HOST:trithuc.jkc.internal}:{$HTTPS_PORT:443}{uri} 308
}
http://127.0.0.1:8081 {
    respond /healthz "ok" 200
}
