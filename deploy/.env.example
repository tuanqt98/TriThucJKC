# Generate distinct URL-safe secrets (at least 20 characters). Never reuse production credentials.
DB_PASSWORD=
DB_RUNTIME_PASSWORD=
DEMO_PASSWORD=
APP_HOST=localhost
APP_ORIGIN=https://localhost:18443
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
HTTPS_PORT=18443
# On a shared dev host choose ports such as 18080/18443 and APP_HOST=localhost.
# APP_ORIGIN must match browser Origin; omit default :443, include custom ports.
# Pin CLAMAV_IMAGE to the verified digest for your architecture before shared staging.
CLAMAV_IMAGE=clamav/clamav:stable
BACKUP_SET=manual
